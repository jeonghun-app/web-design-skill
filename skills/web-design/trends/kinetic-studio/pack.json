{
  "id": "kinetic-studio",
  "name": "Kinetic studio",
  "reviewed": "2026-10",
  "reviewBy": "2027-04",
  "stage": "peak",
  "preferTheme": "dark",
  "summary": "Poster-scale grotesk type that rises word by word, monochrome canvas with one hot accent, sharp edges",
  "fits": [
    "agencies and studios",
    "product launches and campaigns",
    "portfolios",
    "events"
  ],
  "avoid": [
    "task-focused apps",
    "forms and checkout",
    "audiences sensitive to motion"
  ],
  "why": "Size is the first fixation: a headline several times the body size wins attention before anything else, and a short staggered entrance uses motion onset to pull the eye to it exactly once, then stops.",
  "risks": [
    "Motion sensitivity: entrance runs once, <= 500ms per word, and is removed under reduced motion",
    "Huge type wraps badly on small screens: clamp() keeps 3-4 words per line on mobile"
  ],
  "signature": "Word-by-word rising headline at poster scale",
  "fonts": [
