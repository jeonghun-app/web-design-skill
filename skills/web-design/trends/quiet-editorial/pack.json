{
  "id": "quiet-editorial",
  "name": "Quiet editorial",
  "reviewed": "2026-10",
  "reviewBy": "2027-04",
  "stage": "rising",
  "summary": "Monochrome warm paper, large editorial serif display, pill controls, flat cards and generous space",
  "fits": [
    "studios and agencies",
    "luxury and architecture",
    "AI or research companies wanting a humane tone",
    "consulting",
    "long-form content"
  ],
  "avoid": [
    "dense dashboards",
    "discount retail",
    "audiences that need bold call-outs"
  ],
  "why": "Restraint lowers visual complexity (strong first-impression effect) and lets one serif headline become the single focal point; serif display signals editorial care while sans body keeps reading fast.",
  "risks": [
    "Low-chroma palette can make the primary action easy to miss: the CTA stays solid and is the only filled element",
    "Serif under ~20px reads poorly in UI labels: keep labels in sans or mono"
  ],
  "signature": "Oversized serif headline with an italic final word",
  "fonts": [
    {
      "family": "Newsreader",
      "href": "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
    },
