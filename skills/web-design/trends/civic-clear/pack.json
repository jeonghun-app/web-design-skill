  "reviewed": "2026-10",
  "reviewBy": "2027-04",
  "stage": "peak",
  "summary": "Evergreen public-service clarity: larger body text, 48px controls, modest corners, high-contrast neutrals and a trustworthy blue",
  "fits": [
    "government and public services",
    "healthcare and insurance",
    "banking and finance",
    "education",
    "Korean-first services (lang=ko)"
  ],
  "avoid": [
    "fashion or lifestyle brands seeking novelty",
    "campaign and launch pages"
  ],
  "why": "When trust and task completion matter more than novelty, prototypicality and low visual complexity win (strong first-impression effects); larger body text and 48px controls reduce reading and motor errors for the widest age range.",
  "risks": [
    "Can read as bland: keep one strong focal point per page and real imagery",
    "Dense legal copy tempts long lines: keep the measure tokens"
  ],
  "signature": "Calm, unmistakable hierarchy: big clear headings, one blue action per screen",
