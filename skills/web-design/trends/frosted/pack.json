  "summary": "Restrained glass: a floating translucent nav capsule over soft color, solid raised cards, pill controls and springy press feedback",
  "fits": [
    "consumer apps",
    "media and photo products",
    "mobile-first marketing",
    "creative tools"
  ],
  "avoid": [
    "dense data tables",
    "low-end devices",
    "content-heavy reading pages"
  ],
  "why": "Translucency on chrome keeps the page visible behind navigation (context retention) while depth cues separate layers; keeping content surfaces opaque protects text contrast. Full-refraction glass on content is past its peak.",
  "risks": [
    "Text over translucency: chrome tint >= 0.6 alpha and an opaque fallback for reduced transparency",
    "backdrop-filter is GPU-heavy: max one or two glass layers on screen"
  ],
  "signature": "Floating glass navigation capsule",
