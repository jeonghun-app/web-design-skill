  "reviewed": "2026-10",
  "reviewBy": "2027-04",
  "stage": "rising",
  "summary": "Bright pop palette on hard black outlines, offset shadows, chunky display type, sticker accents and grain",
  "fits": [
    "youth consumer brands",
    "food and beverage",
    "fashion drops",
    "creator and music tools"
  ],
  "avoid": [
    "finance, health, government",
    "enterprise B2B",
    "dense information"
  ],
  "why": "Hard outlines and offset shadows give an unmistakable pressable affordance, and saturated color fields make each tile a distinct region; the playfulness signals personality to audiences that reward it.",
  "risks": [
    "Bright fills under light text fail contrast: text on pop colors is always dark",
    "Visual noise competes with the CTA: chaos stays in decorative layers, the reading column stays calm"
  ],
  "signature": "Press-down buttons with hard offset shadows and colored bento tiles",
