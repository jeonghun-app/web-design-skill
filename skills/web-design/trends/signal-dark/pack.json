{
  "id": "signal-dark",
  "name": "Signal dark",
  "reviewed": "2026-10",
  "reviewBy": "2027-04",
  "stage": "rising",
  "preferTheme": "dark",
  "summary": "Dark-first technical look: near-black canvas, hairline grids, mono labels and one luminous accent",
  "fits": [
    "developer tools",
    "AI products and assistants",
    "data and infrastructure",
    "fintech platforms"
  ],
  "avoid": [
    "older or non-technical audiences",
    "warm lifestyle brands",
    "long-form reading"
  ],
  "why": "A dark canvas makes a single luminous accent the most salient element on screen (preattentive color pop); mono labels and grids signal precision to expert audiences, and product UI rendered in the same palette reads as real.",
  "risks": [
    "Thin grey text on near-black loses contrast quickly: muted text stays at L >= 0.72",
    "Glow effects can halo and blur text: glow only on the primary button and on hover"
  ],
  "signature": "Hairline grid that fades out behind the hero, with an accent glow on the primary action",
  "fonts": [
    {
      "family": "Geist",
      "href": "https://fonts.googleapis.com/css2?family=Geist:wght@400..700&display=swap"
    },
