{
  "$description": "Stable base tokens. Trend packs override a subset of these; components only read semantic names.",
  "color": {
    "$type": "color",
    "brand": {
      "$value": "oklch(0.55 0.2 264)",
      "$description": "Primitive brand hue. Most trend packs only need to change this and color.accent-base.",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.7 0.16 264)"
        }
      }
    },
    "accent-base": {
      "$value": "oklch(0.56 0.2 18)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.72 0.17 18)"
        }
      }
    },
    "bg": {
      "$value": "oklch(0.99 0.002 264)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.16 0.008 264)"
        }
      }
    },
    "surface": {
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.2 0.01 264)"
        }
      }
    },
    "surface-raised": {
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.24 0.012 264)"
        }
      }
    },
    "surface-sunken": {
      "$value": "oklch(0.965 0.004 264)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.13 0.006 264)"
        }
      }
    },
    "chrome": {
      "$value": "oklch(from {color.bg} l c h / 0.82)",
      "$description": "Navigation bars, toolbars, sheets: the only places translucency belongs."
    },
    "fg": {
      "$value": "oklch(0.2 0.015 264)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.96 0.005 264)"
        }
      }
    },
    "fg-muted": {
      "$value": "oklch(0.45 0.015 264)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.75 0.012 264)"
        }
      }
    },
    "fg-subtle": {
      "$value": "oklch(0.58 0.012 264)",
      "$description": "Decorative/meta only, never for body text.",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.62 0.012 264)"
        }
      }
    },
    "border": {
      "$value": "oklch(0.9 0.006 264)",
      "$description": "Dividers and card edges (decorative).",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.3 0.012 264)"
        }
      }
    },
    "border-strong": {
      "$value": "oklch(0.56 0.012 264)",
      "$description": "Input borders and other boundaries users must see (3:1).",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.6 0.012 264)"
        }
      }
    },
    "primary": {
      "$value": "{color.brand}"
    },
    "primary-hover": {
      "$value": "oklch(from {color.brand} calc(l - 0.06) c h)",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.brand} calc(l + 0.06) c h)"
        }
      }
    },
    "primary-fg": {
      "$value": "oklch(0.99 0 0)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.16 0.02 264)"
        }
      }
    },
    "primary-soft": {
      "$value": "oklch(from {color.brand} 0.95 0.04 h)",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.brand} 0.3 0.06 h)"
        }
      }
    },
    "primary-soft-fg": {
      "$value": "oklch(from {color.brand} 0.4 c h)",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.brand} 0.88 0.08 h)"
        }
      }
    },
    "primary-text": {
      "$value": "oklch(from {color.brand} 0.46 c h)",
      "$description": "Brand color for text and icons on bg/surface (eyebrows, links, ghost buttons). Always >= 4.5:1.",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.brand} 0.82 c h)"
        }
      }
    },
    "accent": {
      "$value": "{color.accent-base}"
    },
    "accent-fg": {
      "$value": "oklch(0.99 0 0)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.16 0.02 18)"
        }
      }
    },
    "ring": {
      "$value": "{color.brand}"
    },
    "success": {
      "$value": "oklch(0.52 0.13 150)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.72 0.15 150)"
        }
      }
    },
    "success-fg": {
      "$value": "oklch(0.99 0 0)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.16 0.03 150)"
        }
      }
    },
    "warning": {
      "$value": "oklch(0.75 0.15 75)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.8 0.14 75)"
        }
      }
    },
    "warning-fg": {
      "$value": "oklch(0.22 0.04 75)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.2 0.04 75)"
        }
      }
    },
    "danger": {
      "$value": "oklch(0.55 0.2 27)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.7 0.17 27)"
        }
      }
    },
    "danger-fg": {
      "$value": "oklch(0.99 0 0)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0.16 0.03 27)"
        }
      }
    },
    "overlay": {
      "$value": "oklch(0.15 0.01 264 / 0.5)",
      "$extensions": {
        "mode": {
          "dark": "oklch(0 0 0 / 0.6)"
        }
      }
    },
    "illus-ink": {
      "$value": "{color.fg}",
      "$description": "Illustration outline. Follows text color so it stays legible in both modes."
    },
    "illus-paper": {
      "$value": "{color.surface}",
      "$description": "Main object fill: every object sits on a solid fill so strokes never vanish (IL-08).",
      "$extensions": {
        "mode": {
          "dark": "{color.surface-raised}"
        }
      }
    },
    "illus-base": {
      "$value": "oklch(from {color.brand} 0.95 0.03 h)",
      "$description": "Backdrop shape behind the object.",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.brand} 0.3 0.04 h)"
        }
      }
    },
    "illus-accent-1": {
      "$value": "oklch(from {color.brand} 0.72 calc(c * 0.7) h)",
      "$description": "Primary accent: brand, desaturated so art never competes with buttons (IL-07).",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.brand} 0.62 calc(c * 0.6) h)"
        }
      }
    },
    "illus-accent-2": {
      "$value": "oklch(from {color.accent-base} 0.8 calc(c * 0.6) h)",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.accent-base} 0.58 calc(c * 0.55) h)"
        }
      }
    },
    "illus-accent-3": {
      "$value": "oklch(from {color.brand} 0.88 calc(c * 0.4) h)",
      "$extensions": {
        "mode": {
          "dark": "oklch(from {color.brand} 0.42 calc(c * 0.45) h)"
        }
      }
    },
    "illus-shadow": {
      "$value": "oklch(from {color.fg} l c h / 0.12)",
      "$description": "Flat offset shadow shape (no blur filters).",
      "$extensions": {
        "mode": {
          "dark": "oklch(0 0 0 / 0.35)"
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Inter",
        "Pretendard Variable",
        "Pretendard",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Apple SD Gothic Neo",
        "sans-serif"
      ]
    },
    "display": {
      "$value": "{font.sans}"
    },
    "mono": {
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "display": {
      "$value": 650
    },
    "heading": {
      "$value": 600
    },
    "control": {
      "$value": 500
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "0.75rem"
    },
    "xs--line-height": {
      "$value": "1.5",
      "$type": "number"
    },
    "sm": {
      "$value": "0.875rem"
    },
    "sm--line-height": {
      "$value": "1.45",
      "$type": "number"
    },
    "base": {
      "$value": "1rem"
    },
    "base--line-height": {
      "$value": "1.55",
      "$type": "number"
    },
    "lg": {
      "$value": "1.125rem"
    },
    "lg--line-height": {
      "$value": "1.55",
      "$type": "number"
    },
    "lede": {
      "$value": "clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem)"
    },
    "lede--line-height": {
      "$value": "1.5",
      "$type": "number"
    },
    "h3": {
      "$value": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)"
    },
    "h3--line-height": {
      "$value": "1.3",
      "$type": "number"
    },
    "h2": {
      "$value": "clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem)"
    },
    "h2--line-height": {
      "$value": "1.15",
      "$type": "number"
    },
    "display": {
      "$value": "clamp(2.5rem, 1.6rem + 4vw, 4.5rem)"
    },
    "display--line-height": {
      "$value": "1.04",
      "$type": "number"
    }
  },
  "tracking": {
    "$type": "dimension",
    "display": {
      "$value": "-0.03em"
    },
    "heading": {
      "$value": "-0.015em"
    },
    "caps": {
      "$value": "0.06em"
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "One knob: control/card/panel radii derive from it."
    },
    "control": {
      "$value": "calc({radius.base} * 1)"
    },
    "card": {
      "$value": "calc({radius.base} * 1.5)"
    },
    "panel": {
      "$value": "calc({radius.base} * 2.5)"
    },
    "pill": {
      "$value": "9999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": "0 1px 2px oklch(0.2 0.02 264 / 0.06), 0 1px 3px oklch(0.2 0.02 264 / 0.04)",
      "$extensions": {
        "mode": {
          "dark": "0 0 0 1px oklch(1 0 0 / 0.04)"
        }
      }
    },
    "raised": {
      "$value": "0 4px 12px -2px oklch(0.2 0.02 264 / 0.1), 0 2px 4px -2px oklch(0.2 0.02 264 / 0.06)",
      "$extensions": {
        "mode": {
          "dark": "0 8px 24px -4px oklch(0 0 0 / 0.5)"
        }
      }
    },
    "overlay": {
      "$value": "0 24px 48px -12px oklch(0.2 0.02 264 / 0.25)",
      "$extensions": {
        "mode": {
          "dark": "0 24px 48px -12px oklch(0 0 0 / 0.7)"
        }
      }
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "out": {
      "$value": "cubic-bezier(0, 0, 0.2, 1)",
      "$description": "Entering elements (decelerate)."
    },
    "in": {
      "$value": "cubic-bezier(0.4, 0, 1, 1)",
      "$description": "Exiting elements (accelerate)."
    },
    "standard": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)",
      "$description": "On-screen movement."
    },
    "spring": {
      "$value": "linear(0, 0.06 2%, 0.25 5.5%, 0.73 13%, 0.95 19%, 1.04 24%, 1.06 28%, 1.03 36%, 0.99 48%, 1)",
      "$type": "string",
      "$description": "Gentle overshoot; trend packs may tune it."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "micro": {
        "$value": "100ms",
        "$description": "Hover, press, toggle (80-150ms)."
      },
      "small": {
        "$value": "200ms",
        "$description": "Tooltip, dropdown, toast (150-250ms)."
      },
      "large": {
        "$value": "300ms",
        "$description": "Modal, drawer, page (250-400ms)."
      },
      "reveal": {
        "$value": "400ms",
        "$description": "Scroll reveal of large sections; never above 500ms."
      }
    },
    "distance": {
      "$type": "dimension",
      "reveal": {
        "$value": "16px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control-sm": {
      "$value": "2rem"
    },
    "control-md": {
      "$value": "2.5rem"
    },
    "control-lg": {
      "$value": "3rem"
    },
    "touch-min": {
      "$value": "2.75rem",
      "$description": "44px minimum hit area on touch (MO-02)."
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px spacing scale for padding and gaps (also bound to Figma auto layout). Tailwind's p-*/gap-* utilities use the same 4px base.",
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "24": {
      "$value": "6rem"
    }
  },
  "layout": {
    "$type": "dimension",
    "container": {
      "$value": "80rem"
    },
    "prose": {
      "$value": "30em",
      "$description": "Prose measure. em, not ch: '0' is wider than average text. 30em ≈ 70-78 characters in narrow faces like Inter, fewer in wider ones (TY-02 caps at 80)."
    },
    "gutter": {
      "$value": "clamp(1rem, 0.5rem + 2.5vw, 2rem)"
    },
    "section-y": {
      "$value": "clamp(4rem, 2.5rem + 6vw, 8rem)"
    },
    "nav-h": {
      "$value": "4rem"
    },
    "prose-ko": {
      "$value": "32em",
      "$description": "Prose measure for Hangul: glyphs are ~1.5x wider than Latin, so 32em is about 30-45 characters."
    }
  },
  "effect": {
    "border-width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "chrome-blur": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Backdrop blur behind chrome (nav, toolbars)."
    },
    "chrome-saturate": {
      "$type": "number",
      "$value": "1.4"
    },
    "grain-opacity": {
      "$type": "number",
      "$value": "0"
    },
    "hero-bg": {
      "$type": "string",
      "$value": "none",
      "$description": "Background image/gradient behind the hero."
    },
    "display-transform": {
      "$type": "string",
      "$value": "none"
    },
    "card-hover-lift": {
      "$type": "dimension",
      "$value": "-2px"
    }
  },
  "layer": {
    "$type": "number",
    "$description": "Stacking order. content < sticky < drawer < modal < popover < toast < tooltip.",
    "sticky": {
      "$value": 100
    },
    "drawer": {
      "$value": 200
    },
    "modal": {
      "$value": 300
    },
    "popover": {
      "$value": 400
    },
    "toast": {
      "$value": 500
    },
    "tooltip": {
      "$value": 600
    }
  },
  "illus": {
    "stroke": {
      "$type": "number",
      "$value": 2,
      "$description": "Stroke width in a 144 viewBox (≈1.4%). Dark mode thins strokes slightly.",
      "$extensions": {
        "mode": {
          "dark": 1.75
        }
      }
    },
    "cap": {
      "$type": "string",
      "$value": "round"
    },
    "join": {
      "$type": "string",
      "$value": "round"
    },
    "radius": {
      "$type": "number",
      "$value": 6,
      "$description": "Corner radius of object rectangles (viewBox units)."
    },
    "shadow-x": {
      "$type": "dimension",
      "$value": "0px"
    },
    "shadow-y": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Flat shadow offset. Packs set hard offsets (loud) or none."
    }
  }
}
